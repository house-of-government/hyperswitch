separate_authentication_support_for nmi = Just Nmi_separate_authentication_support
separate_authentication_support_for braintree = Just Braintree_separate_authentication_support
separate_authentication_support_for cybersource = Just Cybersource_separate_authentication_support
separate_authentication_support_for archipel = Just Archipel_separate_authentication_support
