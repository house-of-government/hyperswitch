public export
data MissingWebhookAcknowledgement : connector → Type where
  Adyenplatform_missing_webhook_acknowledgement : MissingWebhookAcknowledgement adyenplatform
  Adyen_missing_webhook_acknowledgement : MissingWebhookAcknowledgement adyen

public export
missing_webhook_acknowledgement : connector → Type
missing_webhook_acknowledgement = MissingWebhookAcknowledgement

public export
missing_webhook_acknowledgement_for : (provider : connector) → Maybe (missing_webhook_acknowledgement provider)
missing_webhook_acknowledgement_for adyenplatform = Just Adyenplatform_missing_webhook_acknowledgement
missing_webhook_acknowledgement_for adyen = Just Adyen_missing_webhook_acknowledgement
missing_webhook_acknowledgement_for _ = Nothing

-- A structural plan, not a token, credential, payment permission or HTTP call.
-- A caller cannot attach another connector's/method's certificate to this plan.
public export
data AccessTokenPlan : (connector, payment_method) → Type where
  MkAccessTokenPlan : (selection : (connector, payment_method)) →
                      (0 capability : access_token_support selection) →
                      AccessTokenPlan selection

public export
access_token_selection : AccessTokenPlan selection → (connector, payment_method)
access_token_selection (MkAccessTokenPlan selection _) = selection

public export
plan_access_token : (selection : (connector, payment_method)) → Maybe (AccessTokenPlan selection)
plan_access_token selection =
  case access_token_support_for selection of
    Nothing ⇒ Nothing
    Just capability ⇒ Just (MkAccessTokenPlan selection capability)

-- Compatibility/display projections. Operational callers use the indexed
-- values above. These Bool APIs do not introduce a second rule table.
capability_present : Maybe any_type → Bool
capability_present Nothing = False
capability_present (Just _) = True

public export
supports_access_token : connector → payment_method → Bool
supports_access_token provider method = capability_present (access_token_support_for (provider, method))

public export
requires_order_creation_before_payment : connector → payment_method → Bool
requires_order_creation_before_payment provider _ = capability_present (order_creation_requirement_for provider)

public export
supports_file_storage_module : connector → Bool
supports_file_storage_module provider = capability_present (file_storage_support_for provider)

public export
requires_defend_dispute : connector → Bool
requires_defend_dispute provider = capability_present (dispute_defence_requirement_for provider)

public export
is_separate_authentication_supported : connector → Bool
is_separate_authentication_supported provider = capability_present (separate_authentication_support_for provider)

public export
is_overcapture_supported_by_connector : connector → Bool
is_overcapture_supported_by_connector provider = capability_present (overcapture_support_for provider)

public export
should_acknowledge_webhook_for_resource_not_found_errors : connector → Bool
should_acknowledge_webhook_for_resource_not_found_errors provider = capability_present (missing_webhook_acknowledgement_for provider)
