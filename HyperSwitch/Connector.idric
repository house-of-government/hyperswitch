-- Each constructor certifies one of the existing Rust rules. There is no
-- constructor taking an unchecked Bool. Method indices are checking-only.
-- Absence of access-token support does NOT mean payments are unsupported:
-- a connector may use a different authentication mechanism.
public export
data AccessTokenSupport : (connector, payment_method) → Type where
  Airwallex_token : {0 method : payment_method} → AccessTokenSupport (airwallex, method)
  Deutschebank_token : {0 method : payment_method} → AccessTokenSupport (deutschebank, method)
  Globalpay_token : {0 method : payment_method} → AccessTokenSupport (globalpay, method)
  Jpmorgan_token : {0 method : payment_method} → AccessTokenSupport (jpmorgan, method)
  Moneris_token : {0 method : payment_method} → AccessTokenSupport (moneris, method)
  Nordea_token : {0 method : payment_method} → AccessTokenSupport (nordea, method)
  Paypal_token : {0 method : payment_method} → AccessTokenSupport (paypal, method)
  Payu_token : {0 method : payment_method} → AccessTokenSupport (payu, method)
  Tesouro_token : {0 method : payment_method} → AccessTokenSupport (tesouro, method)
  Iatapay_token : {0 method : payment_method} → AccessTokenSupport (iatapay, method)
  Volt_token : {0 method : payment_method} → AccessTokenSupport (volt, method)
  Itaubank_token : {0 method : payment_method} → AccessTokenSupport (itaubank, method)
  Facilitapay_token : {0 method : payment_method} → AccessTokenSupport (facilitapay, method)
  Dwolla_token : {0 method : payment_method} → AccessTokenSupport (dwolla, method)
  Santander_token : {0 method : payment_method} → AccessTokenSupport (santander, method)
  Truelayer_token : {0 method : payment_method} → AccessTokenSupport (truelayer, method)
  Fiservcommercehub_token : {0 method : payment_method} → AccessTokenSupport (fiservcommercehub, method)
  Trustpay_redirect_token : AccessTokenSupport (trustpay, bank_redirect)
  Trustpay_transfer_token : AccessTokenSupport (trustpay, bank_transfer)

public export
access_token_support : (connector, payment_method) → Type
access_token_support = AccessTokenSupport

public export
access_token_support_for : (selection : (connector, payment_method)) → Maybe (access_token_support selection)
access_token_support_for (airwallex, _) = Just Airwallex_token
access_token_support_for (deutschebank, _) = Just Deutschebank_token
access_token_support_for (globalpay, _) = Just Globalpay_token
access_token_support_for (jpmorgan, _) = Just Jpmorgan_token
access_token_support_for (moneris, _) = Just Moneris_token
access_token_support_for (nordea, _) = Just Nordea_token
access_token_support_for (paypal, _) = Just Paypal_token
access_token_support_for (payu, _) = Just Payu_token
access_token_support_for (tesouro, _) = Just Tesouro_token
access_token_support_for (iatapay, _) = Just Iatapay_token
access_token_support_for (volt, _) = Just Volt_token
access_token_support_for (itaubank, _) = Just Itaubank_token
access_token_support_for (facilitapay, _) = Just Facilitapay_token
access_token_support_for (dwolla, _) = Just Dwolla_token
access_token_support_for (santander, _) = Just Santander_token
access_token_support_for (truelayer, _) = Just Truelayer_token
access_token_support_for (fiservcommercehub, _) = Just Fiservcommercehub_token
access_token_support_for (trustpay, bank_redirect) = Just Trustpay_redirect_token
access_token_support_for (trustpay, bank_transfer) = Just Trustpay_transfer_token
access_token_support_for _ = Nothing

public export
data OrderCreationRequirement : connector → Type where
  Razorpay_order_creation_requirement : OrderCreationRequirement razorpay
  Airwallex_order_creation_requirement : OrderCreationRequirement airwallex

public export
order_creation_requirement : connector → Type
order_creation_requirement = OrderCreationRequirement

public export
order_creation_requirement_for : (provider : connector) → Maybe (order_creation_requirement provider)
order_creation_requirement_for razorpay = Just Razorpay_order_creation_requirement
order_creation_requirement_for airwallex = Just Airwallex_order_creation_requirement
order_creation_requirement_for _ = Nothing

