expected_supports_access_token : connector → payment_method → Bool
expected_supports_access_token airwallex _ = True
expected_supports_access_token deutschebank _ = True
expected_supports_access_token globalpay _ = True
expected_supports_access_token jpmorgan _ = True
expected_supports_access_token moneris _ = True
expected_supports_access_token nordea _ = True
expected_supports_access_token paypal _ = True
expected_supports_access_token payu _ = True
expected_supports_access_token tesouro _ = True
expected_supports_access_token iatapay _ = True
expected_supports_access_token volt _ = True
expected_supports_access_token itaubank _ = True
expected_supports_access_token facilitapay _ = True
expected_supports_access_token dwolla _ = True
expected_supports_access_token santander _ = True
expected_supports_access_token truelayer _ = True
expected_supports_access_token fiservcommercehub _ = True
expected_supports_access_token trustpay bank_redirect = True
expected_supports_access_token trustpay bank_transfer = True
expected_supports_access_token _ _ = False

check_access_token_support_pair : (connector, payment_method) → Bool
check_access_token_support_pair (provider, method) =
  let expected = expected_supports_access_token provider method in
    present (access_token_support_for (provider, method)) == expected &&
    supports_access_token provider method == expected &&
    present (plan_access_token (provider, method)) == expected

check_access_token_support_method : connector → payment_method → Bool
check_access_token_support_method provider method = check_access_token_support_pair (provider, method)

check_access_token_support_connector : connector → Bool
check_access_token_support_connector provider = every (check_access_token_support_method provider) methods

check_access_token_support : Bool
check_access_token_support = every check_access_token_support_connector connectors

expected_requires_order_creation_before_payment : connector → payment_method → Bool
expected_requires_order_creation_before_payment razorpay _ = True
expected_requires_order_creation_before_payment airwallex _ = True
expected_requires_order_creation_before_payment _ _ = False

check_order_creation_requirement_method : connector → payment_method → Bool
check_order_creation_requirement_method provider method =
  let expected = expected_requires_order_creation_before_payment provider method in
    present (order_creation_requirement_for provider) == expected &&
    requires_order_creation_before_payment provider method == expected

check_order_creation_requirement_connector : connector → Bool
check_order_creation_requirement_connector provider = every (check_order_creation_requirement_method provider) methods

check_order_creation_requirement : Bool
check_order_creation_requirement = every check_order_creation_requirement_connector connectors

