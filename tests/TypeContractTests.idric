expected_transition : payment_method_status → payment_method_status → Bool
expected_transition payment_method_inactive payment_method_active = True
expected_transition payment_method_inactive payment_method_new = True
expected_transition payment_method_new payment_method_active = True
expected_transition payment_method_new payment_method_inactive = True
expected_transition _ _ = False

check_transition_target : payment_method_status → payment_method_status → Bool
check_transition_target before after =
  let expected = expected_transition before after in
    present (payment_method_transition_for (before, after)) == expected &&
    can_transition_payment_method_status before after == expected &&
    present (plan_payment_method_change (before, after)) == expected

check_transition_source : payment_method_status → Bool
check_transition_source before = every (check_transition_target before) statuses

check_transitions : Bool
check_transitions = every check_transition_source statuses

policy_persists : locker_id_policy → Bool
policy_persists persist_locker_id = True
policy_persists omit_locker_id = False

expected_locker : payment_method → Bool → Bool
expected_locker card _ = True
expected_locker bank_debit _ = True
expected_locker bank_redirect _ = True
expected_locker wallet check_saved = not check_saved
expected_locker _ _ = False

check_locker_method : payment_method → Bool
check_locker_method method =
  policy_persists (locker_id_policy_for (method, lookup_saved_customer_method)) == expected_locker method True &&
  policy_persists (locker_id_policy_for (method, skip_customer_method_lookup)) == expected_locker method False &&
  should_persist_locker_id_for_saved_payment_method method True == expected_locker method True &&
  should_persist_locker_id_for_saved_payment_method method False == expected_locker method False

check_locker : Bool
check_locker = every check_locker_method methods

