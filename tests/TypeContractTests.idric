check : (String, Bool) → IO ()
check (name, True) = putStrLn ("PASS " ++ name)
check (name, False) = putStrLn ("FAIL " ++ name)

all_pass : Bool
all_pass =
  check_access_token_support &&
  check_order_creation_requirement &&
  check_file_storage_support &&
  check_dispute_defence_requirement &&
  check_separate_authentication_support &&
  check_overcapture_support &&
  check_missing_webhook_acknowledgement &&
  check_transitions &&
  check_locker

main : IO ()
main = do
  check ("access_token_support: 2480 cases", check_access_token_support)
  check ("order_creation_requirement: 2480 cases", check_order_creation_requirement)
  check ("file_storage_support: 155 cases", check_file_storage_support)
  check ("dispute_defence_requirement: 155 cases", check_dispute_defence_requirement)
  check ("separate_authentication_support: 155 cases", check_separate_authentication_support)
  check ("overcapture_support: 155 cases", check_overcapture_support)
  check ("missing_webhook_acknowledgement: 155 cases", check_missing_webhook_acknowledgement)
  check ("all state transitions: 36 cases", check_transitions)
  check ("named locker policies: 32 cases", check_locker)
  if all_pass then pure () else exitFailure
