-- Frozen expectations from the pre-refactor head recorded in type_baseline.json.
-- They deliberately do not call the new deciders to decide expected answers.
present : Maybe any_type → Bool
present Nothing = False
present (Just _) = True

every : (any_type → Bool) → List any_type → Bool
every predicate [] = True
every predicate (value :: rest) = predicate value && every predicate rest

